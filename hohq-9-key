import platform
import shutil
import time

try:
    import psutil
except ImportError:
    print("Missing dependency: psutil")
    print("Install it with: pip install psutil")
    raise SystemExit(1)


def format_bytes(value):
    units = ["B", "KB", "MB", "GB", "TB"]

    for unit in units:
        if value < 1024:
            return f"{value:.1f} {unit}"
        value /= 1024

    return f"{value:.1f} PB"


def get_system_info():
    memory = psutil.virtual_memory()
    disk = shutil.disk_usage("/")

    return {
        "OS": platform.system(),
        "Version": platform.release(),
        "CPU Usage": f"{psutil.cpu_percent(interval=1):.1f}%",
        "RAM Usage": f"{memory.percent:.1f}%",
        "RAM Available": format_bytes(memory.available),
        "Disk Usage": f"{(disk.used / disk.total) * 100:.1f}%",
        "Disk Free": format_bytes(disk.free),
        "Uptime": f"{time.time() - psutil.boot_time():.0f} seconds",
    }


def display(info):
    print("\n" + "=" * 42)
    print("           VEYRONIX MONITOR")
    print("=" * 42)

    for key, value in info.items():
        print(f"{key:<18}: {value}")

    print("=" * 42)


if __name__ == "__main__":
    display(get_system_info())
